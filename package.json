{
  "name": "cullyard",
  "version": "0.2.0",
  "description": "A local desk where your AI agent sorts and edits photos, video, music, documents and PDFs over MCP. Every run can be sealed on Solana devnet.",
  "type": "module",
  "bin": {
    "cullyard": "bin/cullyard.js"
  },
  "files": [
    "bin",
    "src",
    "desk"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/cullyard.js",
    "test": "node --test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "file-organizer",
    "photo-culling",
    "ffmpeg",
    "solana"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bryankwandou/cullyard"
  },
  "homepage": "https://cullyard.vercel.app",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "music-metadata": "^12.2.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
